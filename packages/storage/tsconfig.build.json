{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/memory-store-contract.ts", "src/sqlite-test-store.ts"],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    }
  ]
}
