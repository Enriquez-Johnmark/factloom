{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!spikes",
      "!!.cache",
      "!!.claude",
      "!!docs",
      "!!**/*.md",
      "!!pnpm-lock.yaml",
      "!!skills-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@kronomind/*/**", "**/src/**"],
                "message": "Import another package by its name only, through its index.ts. Do not reach into its files."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kronomind/*", "@kronomind/*/**", "**/src/**"],
                    "message": "core is the innermost package. It must not import another @kronomind package."
                  },
                  {
                    "group": [
                      "better-sqlite3",
                      "sqlite-vec",
                      "@modelcontextprotocol/*",
                      "@anthropic-ai/*",
                      "@huggingface/*"
                    ],
                    "message": "core must not import a database, LLM, embedding or MCP library. It owns the interfaces; outer packages implement them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/graph-rag/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kronomind/storage",
                      "@kronomind/maintenance",
                      "@kronomind/adapters",
                      "@kronomind/*/**",
                      "**/src/**"
                    ],
                    "message": "graph-rag must not import @kronomind/storage, @kronomind/maintenance or @kronomind/adapters, and imports other packages by name only. It reaches storage through the MemoryStore interface in core."
                  },
                  {
                    "group": [
                      "better-sqlite3",
                      "sqlite-vec",
                      "@modelcontextprotocol/*",
                      "@anthropic-ai/*",
                      "@huggingface/*"
                    ],
                    "message": "graph-rag must not import a database, LLM, embedding or MCP library."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/maintenance/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kronomind/storage",
                      "@kronomind/graph-rag",
                      "@kronomind/adapters",
                      "@kronomind/*/**",
                      "**/src/**"
                    ],
                    "message": "maintenance must not import @kronomind/storage, @kronomind/graph-rag or @kronomind/adapters, and imports other packages by name only. It changes memory only through the fact operations in core."
                  },
                  {
                    "group": [
                      "better-sqlite3",
                      "sqlite-vec",
                      "@modelcontextprotocol/*",
                      "@anthropic-ai/*",
                      "@huggingface/*"
                    ],
                    "message": "maintenance must not import a database, LLM, embedding or MCP library."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kronomind/storage", "@kronomind/maintenance", "@kronomind/*/**", "**/src/**"],
                    "message": "adapters must not import @kronomind/storage or @kronomind/maintenance, and imports other packages by name only. A domain adapter is data and mapping; only the app wires it to storage (ADR 0026)."
                  },
                  {
                    "group": [
                      "better-sqlite3",
                      "sqlite-vec",
                      "@modelcontextprotocol/*",
                      "@anthropic-ai/*",
                      "@huggingface/*"
                    ],
                    "message": "adapters must not import a database, LLM, embedding or MCP library."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/storage/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kronomind/graph-rag",
                      "@kronomind/maintenance",
                      "@kronomind/adapters",
                      "@kronomind/*/**",
                      "**/src/**"
                    ],
                    "message": "storage must not import @kronomind/graph-rag, @kronomind/maintenance or @kronomind/adapters, and imports other packages by name only."
                  },
                  {
                    "group": ["@modelcontextprotocol/*", "@anthropic-ai/*", "@huggingface/*"],
                    "message": "storage must not import an LLM, embedding or MCP library."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
