parcel.zone,\n      weightGrams: parcel.weightGrams,\n    });\n    quotes.set(key, { cents: answer.cents, quotedAt: now() });\n    return answer.cents;\n  };\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" import { callCarrier } from './carrier.js';"," "," /** An order whose subtotal reaches this many cents ships for free. */","-export const FREE_SHIPPING_THRESHOLD_CENTS = 5000;","+export const FREE_SHIPPING_THRESHOLD_CENTS = 7500;"," "," /** What shipping costs the customer below the free-shipping threshold, in cents, by zone. */"," export const FLAT_RATES_CENTS = { domestic: 495, europe: 1295, world: 2495 };"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01Qd5KqK5xXPTAZbZW8Zr49D","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
