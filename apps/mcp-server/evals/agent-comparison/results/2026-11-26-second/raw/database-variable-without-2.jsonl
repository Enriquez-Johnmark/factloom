e database url from INVOICE_DB_URL\", () => {\n  const config = readConfig({ INVOICE_DB_URL: \"postgres://invoices\" });\n  assert.equal(config.databaseUrl, \"postgres://invoices\");\n  assert.equal(config.port, 8080);\n});\n\ntest(\"throws when INVOICE_DB_URL is not set\", () => {\n  assert.throws(() => readConfig({}), /INVOICE_DB_URL/);\n});\n\ntest(\"ignores DATABASE_URL, which is the platform's shared database\", () => {\n  assert.throws(() => readConfig({ DATABASE_URL: \"postgres://shared\" }), /INVOICE_DB_URL/);\n});\n"}}}
