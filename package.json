{
  "name": "factloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A memory layer for AI systems: temporal graph RAG with self-correcting and self-healing memory.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "scripts": {
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:types && pnpm run test",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts --passWithNoTests --reporter=verbose && pnpm run eval:retrieval && pnpm run bench",
    "eval:retrieval": "node apps/mcp-server/src/print-retrieval-eval.ts",
    "format": "biome format --write .",
    "mutate:core": "stryker run stryker.config.json",
    "bench": "node apps/mcp-server/src/run-benchmark.ts",
    "build": "tsc -b apps/mcp-server/tsconfig.build.json",
    "pack:archives": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" pack --pack-destination \"$PWD/dist/archives\""
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
